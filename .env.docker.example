# Copy this file to .env.docker on the server and replace every placeholder.
# Use only letters and numbers for POSTGRES_PASSWORD so it is URL-safe in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD
DATABASE_URL=postgresql://familytree:REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD@db:5432/familytree
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
AUTH_URL=https://stammbaum.mausberg.net
AUTH_TRUST_HOST=true
